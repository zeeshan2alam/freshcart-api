# Copy to .env (or set these in your host's dashboard). Every value is optional.

# Signs login tokens. Use 32+ random characters in production. If unset, a random one is made on each start.
SECRET_KEY=

# SQLite by default. For a persistent hosted DB use e.g. postgresql+psycopg://user:pass@host/db (add the driver to requirements).
DATABASE_URL=sqlite:///./freshcart.db

# Comma-separated list of allowed frontend origins. "*" is fine for the demo (auth uses Bearer tokens, not cookies).
CORS_ORIGINS=*

# Admin account created on first start
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@freshcart.com
ADMIN_PASSWORD=admin123

# Demo products, a sale offer, the demo customer and 30 days of sample orders
SEED_DEMO_DATA=true

TOKEN_EXPIRE_MINUTES=720
